HOST=127.0.0.1
PORT=4000
FIREBASE_PROJECT_ID=ligtas-d7a4c
# Firebase web API key from the same project's web-app configuration.
FIREBASE_WEB_API_KEY=
# Absolute private file path, for example C:/Users/your-name/private/firebase-admin.json.
# Leave blank to use an existing Application Default Credentials setup,
# or the ignored serviceAccountKey.json file in this repository's root.
GOOGLE_APPLICATION_CREDENTIALS=
# Leave disabled during initial setup. Enabling processes real delivery jobs.
ENABLE_NOTIFICATION_WORKERS=false
