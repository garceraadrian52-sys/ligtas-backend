HOST=127.0.0.1
PORT=4000
FIREBASE_PROJECT_ID=ligtas-d7a4c
# Firebase web API key from the same project's web-app configuration.
FIREBASE_WEB_API_KEY=AIzaSyC8WxjVYOLxs2qvSVsGDuKydjdXcvmFUNA
# Absolute private file path, for example C:/Users/your-name/private/firebase-admin.json.
# Leave blank to use an existing Application Default Credentials setup,
# or the ignored serviceAccountKey.json file in this repository's root.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/Jaycel/Downloads/ligtas-d7a4c-firebase-adminsdk-fbsvc-ca7d76909a.json
# Leave disabled during initial setup. Enabling processes real delivery jobs.
ENABLE_NOTIFICATION_WORKERS=false
# Outgoing email for access-request rejection messages.
# Gmail / Google Workspace: set SMTP_USER to the sender address.
# Set SMTP_PASS to a Google app password and SMTP_FROM to the sender address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true
